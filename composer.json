{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "madtechservices/madcms",
    "description": "MAD CMS reusable page builder, module system, and form builder for Laravel.",
    "homepage": "https://github.com/madtechservices/madcms",
    "type": "library",
    "license": "proprietary",
    "keywords": [
        "cms",
        "laravel",
        "inertia",
        "page-builder",
        "react"
    ],
    "authors": [
        {
            "name": "MAD Tech Services",
            "email": "madtechservices@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0 || ^12.0 || ^13.0",
        "illuminate/database": "^11.0 || ^12.0 || ^13.0",
        "illuminate/http": "^11.0 || ^12.0 || ^13.0",
        "illuminate/mail": "^11.0 || ^12.0 || ^13.0",
        "illuminate/support": "^11.0 || ^12.0 || ^13.0",
        "illuminate/validation": "^11.0 || ^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "MadTechServices\\MadCms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MadTechServices\\MadCms\\MadCmsServiceProvider"
            ]
        },
        "madcms": {
            "frontend_contract": 1,
            "frontend_entrypoint": "resources/js/index.ts"
        }
    },
    "support": {
        "issues": "https://github.com/madtechservices/madcms/issues",
        "source": "https://github.com/madtechservices/madcms"
    },
    "suggest": {
        "inertiajs/inertia-laravel": "Required only when the optional MAD CMS Inertia presentation routes are enabled."
    }
}
