{
    "manifest_version": 1,
    "name": "MAD CMS",
    "slug": "madcms",
    "version": "0.1.0-rc.1",
    "composer": {
        "package": "madtechservices/madcms",
        "constraint": "^0.1"
    },
    "install": ["php artisan madcms:install", "php artisan madcms:status"],
    "requirements": {
        "php": "^8.2",
        "laravel": "^11.0 || ^12.0",
        "frontend_contract": 1
    },
    "capabilities": ["cms.pages", "cms.modules", "cms.forms", "cms.submissions", "cms.categories", "cms.builder", "cms.frontend-contract", "cms.admin-ui"]
}
